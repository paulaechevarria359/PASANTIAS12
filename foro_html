<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Foro Comunitario - Recetario</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100 min-h-screen text-gray-800">

    <header class="bg-indigo-600 text-white shadow-md sticky top-0 z-50">
        <div class="max-w-5xl mx-auto px-4 py-4 flex justify-between items-center">
            <h1 class="text-2xl font-bold flex items-center gap-2">
                <i class="fa-solid fa-comments"></i> Mi Foro
            </h1>
            <button onclick="abrirModal()" class="bg-white text-indigo-600 font-semibold px-4 py-2 rounded-lg shadow hover:bg-gray-100 transition">
                <i class="fa-solid fa-plus mr-1"></i> Nueva Publicación
            </button>
        </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 py-8 grid grid-cols-1 md:grid-cols-4 gap-6">

        <aside class="md:col-span-1 bg-white p-4 rounded-xl shadow-sm h-fit">
            <h2 class="font-bold text-gray-700 mb-3 border-b pb-2">Categorías</h2>
            <ul class="space-y-1 text-sm font-medium">
                <li><button onclick="filtrarCategoria('todas')" class="w-full text-left px-3 py-2 rounded-lg hover:bg-indigo-50 hover:text-indigo-600 transition flex justify-between items-center"><span><i class="fa-solid fa-globe mr-2"></i>Todas</span></button></li>
                <li><button onclick="filtrarCategoria('General')" class="w-full text-left px-3 py-2 rounded-lg hover:bg-indigo-50 hover:text-indigo-600 transition">📌 General</button></li>
                <li><button onclick="filtrarCategoria('Tecnología')" class="w-full text-left px-3 py-2 rounded-lg hover:bg-indigo-50 hover:text-indigo-600 transition">💻 Tecnología</button></li>
                <li><button onclick="filtrarCategoria('Discusión')" class="w-full text-left px-3 py-2 rounded-lg hover:bg-indigo-50 hover:text-indigo-600 transition">💬 Discusión</button></li>
                <li><button onclick="filtrarCategoria('Dudas')" class="w-full text-left px-3 py-2 rounded-lg hover:bg-indigo-50 hover:text-indigo-600 transition">❓ Dudas</button></li>
            </ul>
        </aside>

        <section class="md:col-span-3 space-y-4" id="contenedorPublicaciones">
            </section>

    </main>

    <div id="modalPost" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-lg overflow-hidden">
            <div class="bg-indigo-600 px-6 py-4 text-white flex justify-between items-center">
                <h3 class="font-bold text-lg">Crear Nueva Publicación</h3>
                <button onclick="cerrarModal()" class="text-white hover:text-gray-200 text-xl font-bold">&times;</button>
            </div>
            <form id="formNuevaPublicacion" class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Tu Nombre / Usuario</label>
                    <input type="text" id="autorPost" required placeholder="Ej. Carlos" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Título de la publicación</label>
                    <input type="text" id="tituloPost" required placeholder="¿De qué quieres hablar?" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Categoría</label>
                    <select id="categoriaPost" class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none">
                        <option value="General">General</option>
                        <option value="Tecnología">Tecnología</option>
                        <option value="Discusión">Discusión</option>
                        <option value="Dudas">Dudas</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Contenido / Mensaje</label>
                    <textarea id="contenidoPost" rows="4" required placeholder="Escribe tu mensaje aquí..." class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none"></textarea>
                </div>
                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" onclick="cerrarModal()" class="px-4 py-2 border rounded-lg text-gray-600 hover:bg-gray-100">Cancelar</button>
                    <button type="submit" class="px-4 py-2 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700">Publicar</button>
                </div>
            </form>
        </div>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/12.17.1/firebase-app.js";
        import { getAnalytics } from "https://www.gstatic.com/firebasejs/12.17.1/firebase-analytics.js";
        import { getDatabase, ref, push, onValue, update, remove } from "https://www.gstatic.com/firebasejs/12.17.1/firebase-database.js";

        const firebaseConfig = {
            apiKey: "AIzaSyCFG_XzeX7jpz-dG6xyaza6ONwJN19iATY",
            authDomain: "foto-recetario.firebaseapp.com",
            databaseURL: "https://foto-recetario-default-rtdb.firebaseio.com",
            projectId: "foto-recetario",
            storageBucket: "foto-recetario.firebasestorage.app",
            messagingSenderId: "1014058770570",
            appId: "1:1014058770570:web:ba6f9220d0aa5920c10d73",
            measurementId: "G-3LW68P9QY0"
        };

        const app = initializeApp(firebaseConfig);
        const analytics = getAnalytics(app);
        const database = getDatabase(app);
        const postsRef = ref(database, 'publicaciones');

        let publicaciones = {};
        let filtroActual = 'todas';

        // Escuchar datos en tiempo real desde Firebase
        onValue(postsRef, (snapshot) => {
            publicaciones = snapshot.val() || {};
            renderizarPublicaciones();
        });

        // Guardar nueva publicación en Firebase Realtime Database
        document.getElementById('formNuevaPublicacion').addEventListener('submit', (e) => {
            e.preventDefault();
            const autor = document.getElementById('autorPost').value;
            const titulo = document.getElementById('tituloPost').value;
            const categoria = document.getElementById('categoriaPost').value;
            const contenido = document.getElementById('contenidoPost').value;

            push(postsRef, {
                autor,
                titulo,
                categoria,
                contenido,
                fecha: new Date().toLocaleDateString('es-ES'),
                likes: 0,
                comentarios: []
            });

            cerrarModal();
            document.getElementById('formNuevaPublicacion').reset();
        });

        // Renderizar publicaciones en pantalla
        window.renderizarPublicaciones = function() {
            const contenedor = document.getElementById('contenedorPublicaciones');
            contenedor.innerHTML = '';

            const keys = Object.keys(publicaciones).reverse();
            const postsFiltrados = keys.filter(key => {
                if (filtroActual === 'todas') return true;
                return publicaciones[key].categoria === filtroActual;
            });

            if (postsFiltrados.length === 0) {
                contenedor.innerHTML = `
                    <div class="bg-white p-8 rounded-xl text-center text-gray-500 shadow-sm">
                        <i class="fa-regular fa-folder-open text-4xl mb-2"></i>
                        <p>No hay publicaciones en esta categoría todavía.</p>
                    </div>`;
                return;
            }

            postsFiltrados.forEach(key => {
                const post = publicaciones[key];
                const comentariosList = post.comentarios ? Object.values(post.comentarios) : [];

                const postHTML = `
                    <article class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition">
                        <div class="flex justify-between items-start mb-2">
                            <div>
                                <span class="text-xs font-bold uppercase tracking-wider bg-indigo-100 text-indigo-700 px-2.5 py-1 rounded-full">${escaparHTML(post.categoria)}</span>
                                <h3 class="text-xl font-bold text-gray-900 mt-2">${escaparHTML(post.titulo)}</h3>
                            </div>
                            <button onclick="eliminarPost('${key}')" class="text-gray-400 hover:text-red-500 transition text-sm" title="Eliminar post">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>

                        <div class="text-xs text-gray-500 mb-4 flex items-center gap-3">
                            <span><i class="fa-regular fa-user"></i> ${escaparHTML(post.autor)}</span>
                            <span>•</span>
                            <span><i class="fa-regular fa-clock"></i> ${post.fecha}</span>
                        </div>

                        <p class="text-gray-700 mb-6 whitespace-pre-line leading-relaxed">${escaparHTML(post.contenido)}</p>

                        <div class="flex items-center gap-4 border-t pt-4 text-sm text-gray-600">
                            <button onclick="darLike('${key}', ${post.likes || 0})" class="flex items-center gap-1.5 hover:text-red-500 transition font-medium">
                                <i class="fa-solid fa-heart text-red-500"></i> ${post.likes || 0} Me gusta
                            </button>
                            <span class="flex items-center gap-1.5 font-medium">
                                <i class="fa-regular fa-comment"></i> ${comentariosList.length} Comentarios
                            </span>
                        </div>

                        <div class="mt-4 pt-4 border-t border-gray-100 space-y-3 bg-gray-50 p-4 rounded-lg">
                            <h4 class="font-bold text-xs text-gray-500 uppercase tracking-wide">Comentarios</h4>
                            <div class="space-y-2">
                                ${comentariosList.map(c => `
                                    <div class="bg-white p-3 rounded-md shadow-2xs text-sm">
                                        <div class="flex justify-between text-xs text-gray-500 mb-1">
                                            <span class="font-bold text-indigo-600">${escaparHTML(c.autor)}</span>
                                            <span>${c.fecha}</span>
                                        </div>
                                        <p class="text-gray-700">${escaparHTML(c.texto)}</p>
                                    </div>
                                `).join('')}
                            </div>

                            <form onsubmit="agregarComentario(event, '${key}')" class="mt-3 flex gap-2">
                                <input type="text" placeholder="Tu usuario" required id="autorComentario-${key}" class="w-1/3 px-3 py-1.5 border rounded-lg text-sm outline-none focus:ring-1 focus:ring-indigo-500">
                                <input type="text" placeholder="Escribe un comentario..." required id="textoComentario-${key}" class="w-full px-3 py-1.5 border rounded-lg text-sm outline-none focus:ring-1 focus:ring-indigo-500">
                                <button type="submit" class="bg-indigo-600 text-white px-3 py-1.5 rounded-lg text-sm hover:bg-indigo-700 font-medium">Comentar</button>
                            </form>
                        </div>
                    </article>
                `;
                contenedor.innerHTML += postHTML;
            });
        };

        // Agregar comentario conectado a Firebase
        window.agregarComentario = function(e, key) {
            e.preventDefault();
            const autorInput = document.getElementById(`autorComentario-${key}`);
            const textoInput = document.getElementById(`textoComentario-${key}`);

            const comentariosRef = ref(database, `publicaciones/${key}/comentarios`);
            push(comentariosRef, {
                autor: autorInput.value,
                texto: textoInput.value,
                fecha: new Date().toLocaleDateString('es-ES')
            });
        };

        // Dar Me Gusta en Firebase
        window.darLike = function(key, currentLikes) {
            const postRef = ref(database, `publicaciones/${key}`);
            update(postRef, { likes: currentLikes + 1 });
        };

        // Eliminar publicación en Firebase
        window.eliminarPost = function(key) {
            if (confirm("¿Estás seguro de que deseas eliminar esta publicación?")) {
                const postRef = ref(database, `publicaciones/${key}`);
                remove(postRef);
            }
        };

        // Filtrar por categoría
        window.filtrarCategoria = function(cat) {
            filtroActual = cat;
            renderizarPublicaciones();
        };

        // Modal Controls
        window.abrirModal = function() {
            document.getElementById('modalPost').classList.remove('hidden');
        };

        window.cerrarModal = function() {
            document.getElementById('modalPost').classList.add('hidden');
        };

        function escaparHTML(str) {
            if (!str) return '';
            return str.replace(/[&<>'"]/g, 
                tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
            );
        }
    </script>
</body>
</html>